/dts-v1/;
#include <dt-bindings/usb/pd.h>
#include "exynos9820-common.dtsi"

/ {
	model = "Samsung Galaxy S10+ (SM-G975F)";
	compatible = "samsung,beyond2lte", "samsung,exynos9820";
	chassis-type = "handset";

	/* Real DRAM layout measured from the recovery kernel (/proc/iomem).
	 * Holes between banks: S-Boot/loader remnants and modem carveouts. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x3ab00000>,
		      <0x0 0xc0000000 0x20000000>,
		      <0x0 0xe1900000 0x1e700000>,
		      <0x8 0x80000000 0x80000000>,
		      <0x9 0x00000000 0x80000000>,
		      <0x9 0x80000000 0x80000000>;
	};

	chosen {
		/* Android boot args. S-Boot normally supplies these; uniLoader
		 * passes only our DTB, so they live here. hardware=exynos9820
		 * matches the ROM's fstab.exynos9820 (Samsung platform name). */
		bootargs = "console=tty0 loglevel=4 printk.devkmsg=on androidboot.hardware=exynos9820 androidboot.super_partition=system androidboot.boot_devices=soc@0/13d60000.ufs androidboot.verifiedbootstate=orange androidboot.selinux=permissive androidboot.serialno=beyond2lte001 firmware_class.path=/vendor/firmware brcmfmac.roamoff=1 brcmfmac.host_wake=gpa0:7 pd_ignore_unused clk_ignore_unused";

		framebuffer0: framebuffer@ca000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xca000000 (1440 * 3040 * 4)>;
			width = <1440>;
			height = <3040>;
			stride = <(1440 * 4)>;
			/* Hardware FB is XRGB8888; declare a8b8g8r8 so simpledrm's
			 * xrgb8888_to_abgr8888 blit swaps Android's RGBA R<->B channels. */
			format = "a8b8g8r8";
			panel = <&panel>;

			/* Dummy panel for simple-framebuffer dimension info */
			panel: dummy-panel {
				width-mm = <70>;
				height-mm = <147>;
			};
		};
	};
	reserved-memory {
		/*
		 * IOVA only: the MFC's window is stock's [0x10000000,
		 * 0xd0000000) (s5p-mfc puts the firmware at its start).
		 */
		mfc_iova: mfc-iova-reserved {
			iommu-addresses = <&mfc 0x0 0x10000000>,
					  <&mfc 0xd0000000 0x30000000>;
		};
	};
};

&mfc {
	memory-region = <&mfc_iova>;
	status = "okay";
};

&battery {
	compatible = "simple-battery";
	constant-charge-current-max-microamp = <2850000>;
	charge-full-design-microamp-hours = <4000000>;
};

&decon {
	memory-region = <&fb_region>;
	width-mm = <70>;
	height-mm = <147>;
	status = "okay";
};

&pinctrl_alive {
	codec_irq: codec-irq-pins {
		samsung,pins = "gpa2-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};
};

&pinctrl_cmgp {
	amp_irq: amp-irq-pins {
		samsung,pins = "gpm24-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};
};

&pinctrl_peric0 {
	spi2_bus: spi2-bus-pins {
		samsung,pins = "gpp0-6", "gpp0-5", "gpp0-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};

	spi2_cs: spi2-cs-pins {
		samsung,pins = "gpp0-7";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <0>;
	};

	codec_reset: codec-reset-pins {
		samsung,pins = "gpg1-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};
};

&pinctrl_peric1 {
	hsi2c38_bus: hsi2c38-bus-pins {
		samsung,pins = "gph0-6", "gph0-7";
		samsung,pin-function = <EXYNOS_PIN_FUNC_3>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};

	spk_amp_reset: spk-amp-reset-pins {
		samsung,pins = "gph1-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};

	rcv_amp_reset: rcv-amp-reset-pins {
		samsung,pins = "gph1-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};
};

&pinctrl_aud {
	uaif0_bus: uaif0-bus-pins {
		samsung,pins = "gpb0-1", "gpb0-2", "gpb0-3", "gpb0-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	uaif0_idle: uaif0-idle-pins {
		samsung,pins = "gpb0-1", "gpb0-2", "gpb0-3", "gpb0-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	uaif1_bus: uaif1-bus-pins {
		samsung,pins = "gpb1-0", "gpb1-1", "gpb1-2", "gpb1-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	uaif1_idle: uaif1-idle-pins {
		samsung,pins = "gpb1-0", "gpb1-1", "gpb1-2", "gpb1-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};
};

&abox {
	memory-region = <&abox_fw_mem>;
	pinctrl-names = "active", "idle";
	pinctrl-0 = <&uaif0_bus &uaif1_bus>;
	pinctrl-1 = <&uaif0_idle &uaif1_idle>;
	status = "okay";
};

&usi01_usi {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_bus &spi2_cs>;
	cs-gpios = <&gpp0 7 GPIO_ACTIVE_LOW>;
	status = "okay";

	codec: codec@0 {
		compatible = "cirrus,cs47l93";
		reg = <0>;
		spi-max-frequency = <5000000>;

		pinctrl-names = "default";
		pinctrl-0 = <&codec_reset &codec_irq>;
		reset-gpios = <&gpg1 0 GPIO_ACTIVE_LOW>;

		interrupt-controller;
		#interrupt-cells = <2>;
		interrupts-extended = <&gpa2 2 IRQ_TYPE_LEVEL_LOW>;

		gpio-controller;
		#gpio-cells = <2>;
		#sound-dai-cells = <1>;

		AVDD-supply = <&ldo17m>;
		DBVDD1-supply = <&ldo17m>;
		CPVDD1-supply = <&ldo17m>;
		CPVDD2-supply = <&ldo18m>;
		DCVDD-supply = <&ldo18m>;

		clocks = <&pmu_system_controller 0>;
		clock-names = "mclk1";
		assigned-clocks = <&pmu_system_controller 0>;
		assigned-clock-parents = <&oscclk>;

		cirrus,dmic-ref = <0 0 1 1>;
		cirrus,inmode = <0 0 0 0
				 0 0 1 1>;
		cirrus,out-mono = <0 0 0 1 0 0>;

		micvdd {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
		};

		codec_aif1: pin-settings {
			aif1-pins {
				groups = "aif1";
				function = "aif1";
				bias-bus-hold;
			};
		};
	};
};

&usi17_i2c {
	samsung,mode = <USI_MODE_I2C>;
	status = "okay";
};

&hsi2c_38 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c38_bus &amp_irq>;
	status = "okay";

	spk_amp: amplifier@40 {
		compatible = "cirrus,cs35l40";
		reg = <0x40>;
		#sound-dai-cells = <1>;
		sound-name-prefix = "SPK";

		pinctrl-names = "default";
		pinctrl-0 = <&spk_amp_reset>;
		reset-gpios = <&gph1 1 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&gpm24 0 IRQ_TYPE_LEVEL_LOW>;

		cirrus,boost-type = <0>;
		cirrus,boost-peak-milliamp = <4100>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <15>;
		cirrus,asp-sdout-hiz = <3>;
	};

	rcv_amp: amplifier@41 {
		compatible = "cirrus,cs35l40";
		reg = <0x41>;
		#sound-dai-cells = <1>;
		sound-name-prefix = "RCV";

		pinctrl-names = "default";
		pinctrl-0 = <&rcv_amp_reset>;
		reset-gpios = <&gph1 2 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&gpm24 0 IRQ_TYPE_LEVEL_LOW>;

		cirrus,boost-type = <0>;
		cirrus,boost-peak-milliamp = <4100>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <15>;
		cirrus,asp-sdout-hiz = <3>;
	};
};

&pinctrl_alive {
	btp_ipc: btp-ipc-pins {
		samsung,pins = "gpa1-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <3>;
	};

	btp_wuhb: btp-wuhb-pins {
		samsung,pins = "gpa1-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
		samsung,pin-drv = <3>;
	};

	uart1_bus: uart1-bus-pins {
		samsung,pins = "gpq0-3", "gpq0-2", "gpq0-1", "gpq0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <0>;
	};

	bt_hostwake: bt-hostwake-pins {
		samsung,pins = "gpa2-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	shub_host_req: shub-host-req-pins {
		samsung,pins = "gpa1-7";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	shub_ap_sleep: shub-ap-sleep-pins {
		samsung,pins = "gpa0-5";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};

	shub_int: shub-int-pins {
		samsung,pins = "gpa4-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};
};

&pinctrl_cmgp {
	bt_en: bt-en-pins {
		samsung,pins = "gpm8-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};
};

&pinctrl_peric0 {
	spi1_bus: spi1-bus-pins {
		samsung,pins = "gpp0-2", "gpp0-1", "gpp0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
		samsung,pin-drv = <3>;
	};

	spi1_cs_func_high: spi1-cs-func-high-pins {
		samsung,pins = "gpp0-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <3>;
		samsung,pin-val = <1>;
	};

	spi1_bus_sleep: spi1-bus-sleep-pins {
		samsung,pins = "gpp0-2", "gpp0-1", "gpp0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
		samsung,pin-drv = <3>;
	};

	spi1_cs: spi1-cs-pins {
		samsung,pins = "gpp0-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};

	bt_btwake: bt-btwake-pins {
		samsung,pins = "gpg2-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};

	shub_pwr_en: shub-pwr-en-pins {
		samsung,pins = "gpg0-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	shub_mcu_req: shub-mcu-req-pins {
		samsung,pins = "gpg4-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};

	shub_mcu_resp: shub-mcu-resp-pins {
		samsung,pins = "gpg4-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};
};

&pinctrl_peric1 {
	btp_ldo: btp-ldo-pins {
		samsung,pins = "gph1-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <3>;
	};

	spi17_bus: spi17-bus-pins {
		samsung,pins = "gph0-2", "gph0-1", "gph0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <0>;
	};

	spi17_cs: spi17-cs-pins {
		samsung,pins = "gph0-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <0>;
	};
};

&usbdrd_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "peripheral";

	port {
		usbdrd_dwc3_hs: endpoint {
			remote-endpoint = <&max77705_typec_hs>;
		};
	};
};

&max77705_charger {
	max77705_otg_vbus: usb-otg-vbus {
		regulator-name = "usb_otg_vbus";
	};
};

&hsi2c45 {
	typec@25 {
		compatible = "maxim,max77705-usbc";
		reg = <0x25>;
		interrupt-parent = <&max77705>;
		interrupts = <3>;
		vbus-supply = <&max77705_otg_vbus>;
		maxim,charger = <&max77705_charger>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "sink";
			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_DUAL_ROLE |
						PDO_FIXED_HIGHER_CAP |
						PDO_FIXED_USB_COMM |
						PDO_FIXED_DATA_SWAP)
				     PDO_FIXED(9000, 1670, 0)>;
			op-sink-microwatt = <15000000>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					max77705_typec_hs: endpoint {
						remote-endpoint = <&usbdrd_dwc3_hs>;
					};
				};
			};
		};
	};
};

&usi_uart_bt {
	samsung,mode = <USI_MODE_UART>;
	samsung,clkreq-on;
	status = "okay";
};

&serial1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_bus>;
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4375-bt";
		pinctrl-names = "default";
		pinctrl-0 = <&bt_en &bt_btwake &bt_hostwake>;
		shutdown-gpios = <&gpm8 0 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpg2 0 GPIO_ACTIVE_HIGH>;
		host-wakeup-gpios = <&gpa2 3 GPIO_ACTIVE_HIGH>;
		max-speed = <3000000>;
	};
};

&usi16 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi17 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi17_bus &spi17_cs>;
	cs-gpios = <&gph0 3 GPIO_ACTIVE_LOW>;
	status = "okay";

	sensorhub@0 {
		compatible = "brcm,bcm4775-shub";
		reg = <0>;
		spi-max-frequency = <25000000>;
		spi-cpol;
		spi-cpha;

		pinctrl-names = "default";
		pinctrl-0 = <&shub_host_req &shub_ap_sleep &shub_int
			     &shub_pwr_en &shub_mcu_req &shub_mcu_resp>;
		vdd-supply = <&ldo21m>;
		pwr-en-gpios = <&gpg0 2 GPIO_ACTIVE_HIGH>;
		mcu-req-gpios = <&gpg4 1 GPIO_ACTIVE_HIGH>;
		mcu-resp-gpios = <&gpg4 2 GPIO_ACTIVE_HIGH>;
		host-req-gpios = <&gpa1 7 GPIO_ACTIVE_HIGH>;
		ap-sleep-gpios = <&gpa0 5 GPIO_ACTIVE_HIGH>;
	};
};

/ {
	qbt2000 {
		compatible = "qcom,qbt2000";
		qcom,ipc-gpios = <&gpa1 3 GPIO_ACTIVE_HIGH>;
		qcom,wuhb-gpios = <&gpa1 1 GPIO_ACTIVE_HIGH>;
		qcom,ldo-gpios = <&gph1 0 GPIO_ACTIVE_HIGH>;
		qcom,position = "13.83,0.00,9.00,4.00,14.80,14.80,13.00,13.00,5.00";
		qcom,modelinfo = "G97X";
		clock-names = "fp-spi-pclk", "fp-spi-sclk";
		clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI00_USI_PCLK>,
			 <&cmu_peric0 CLK_GOUT_PERIC0_USI00_USI_IPCLK>;
		pinctrl-names = "default", "pins_poweron", "pins_poweroff";
		pinctrl-0 = <&btp_ipc &btp_wuhb &btp_ldo>;
		pinctrl-1 = <&spi1_bus &spi1_cs_func_high>;
		pinctrl-2 = <&spi1_bus_sleep &spi1_cs>;
	};

	sound {
		compatible = "samsung,beyond0lte-madera";
		pinctrl-names = "default";
		pinctrl-0 = <&codec_aif1>;
		samsung,audio-codec = <&codec>;
		samsung,audio-cpu = <&abox>;
		samsung,speaker-amps = <&rcv_amp>, <&spk_amp>;
	};
};
