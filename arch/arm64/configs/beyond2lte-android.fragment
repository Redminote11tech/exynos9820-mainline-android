# Android (Infinity X) support fragment for beyond2lte mainline kernel
# Applied on top of the postmarketOS exynos9820 base config.
# Merge with: scripts/kconfig/merge_config.sh

# Kernel identity
CONFIG_LOCALVERSION="-beyond2lte-mainline-android"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="beyond2lte"

# Android binder: keep static devices AND binderfs (modern init)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Dynamic partitions (super): device-mapper linear targets
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=m
CONFIG_DM_DEFAULT_KEY=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_DM_UEVENT=y

# dmabuf heaps for gralloc/allocator on modern Android
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# Filesystem coverage for GSIs
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_PASSTHROUGH=y

# KernelSU Next (drivers/kernelsu)
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set

# Bring-up diagnostics: keep the panic message on screen until power cycle
CONFIG_PANIC_TIMEOUT=0

# Misc Android runtime needs
CONFIG_BLK_CGROUP=y
CONFIG_CPUSETS_V1=y
CONFIG_KEYS=y
CONFIG_PERSISTENT_KEYRINGS=y
CONFIG_UNIX98_PTYS=y
CONFIG_INOTIFY_USER=y
CONFIG_EXYNOS_DSS_LAST_KMSG=y
CONFIG_UNICODE=y
CONFIG_FS_VERITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZORLE=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CGROUP=y
CONFIG_NETFILTER_XT_MATCH_ESP=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_TCPMSS=y
CONFIG_IP6_NF_MATCH_AH=y
CONFIG_IP6_NF_MATCH_EUI64=y
CONFIG_IP6_NF_MATCH_FRAG=y
CONFIG_IP6_NF_MATCH_OPTS=y
CONFIG_IP6_NF_MATCH_HL=y
CONFIG_IP6_NF_MATCH_IPV6HEADER=y
CONFIG_IP6_NF_MATCH_MH=y
CONFIG_IP6_NF_MATCH_RT=y
CONFIG_DRM_PANFROST=y
CONFIG_SYNC_FILE=y
